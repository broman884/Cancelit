<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--  Needed on API 33+ to show the "Are you there?" presence-check notification.  -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!--  Lets the Blocklist show each app's real icon (Android 11+ hides other apps by default).
             Add a line here for any other app you want an icon for; unlisted apps fall back to a letter tile.  -->
    <queries>
        <package android:name="com.google.android.youtube"/>
        <package android:name="com.instagram.android"/>
        <package android:name="com.zhiliaoapp.musically"/>
        <package android:name="com.android.chrome"/>
        <package android:name="org.mozilla.firefox"/>
        <package android:name="com.snapchat.android"/>
        <package android:name="com.facebook.katana"/>
        <package android:name="com.twitter.android"/>
        <package android:name="com.reddit.frontpage"/>
        <package android:name="com.netflix.mediaclient"/>
        <package android:name="tv.twitch.android.app"/>
        <package android:name="com.discord"/>
        <package android:name="com.pinterest"/>
        <package android:name="org.telegram.messenger"/>
    </queries>
    <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name" android:theme="@style/Theme.CancelIt">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".service.FocusAccessibilityService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config"/>
        </service>
    </application>
</manifest>